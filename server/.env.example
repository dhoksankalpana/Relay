# Copy to .env and fill in only what you need — every value is optional.
# Nothing here is required: Relay boots with an in-memory dataset + deterministic AI engine.

# --- Database (optional) -------------------------------------------------
# When omitted, the server runs on an auto-seeded in-memory store and the
# header will read "In-memory store". When present, data is persisted via Mongoose.
# MONGODB_URI=mongodb://127.0.0.1:27017/relay

# --- Live LLM (optional) -------------------------------------------------
# When omitted, all AI features use the deterministic context-aware mock engine
# and the UI shows "Simulated AI". Set ONE of the keys below to switch to live LLM.
# LLM_API_KEY=sk-...
# LLM_PROVIDER=openai            # openai | gemini
# LLM_MODEL=gpt-4o-mini          # gemini-1.5-flash for Gemini
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Server --------------------------------------------------------------
PORT=5050
